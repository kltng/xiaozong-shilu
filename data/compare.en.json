/span></summary><pre class='code'># /// script\n# requires-python = &quot;&gt;=3.11&quot;\n# ///\n&quot;&quot;&quot;Step 09b, local reader. A model served by Ollama on this machine reads each batch.\n\n  uv run extract_local.py RUN --model qwen3.8:27b [--think] [--ctx 16384] [--only b001,b002]\n\nSame prompt.md, same schema.json and the same batches as the Codex reader (extract.py), so\nonly the reader changes. Nothing leaves this machine.\nIn:  &lt;run&gt;/batches/bNNN.json\nOut: &lt;run&gt;/raw/bNNN.json       the model&#x27;s answer, exactly as returned\n     &lt;run&gt;/raw/bNNN.meta.json  model, options, seconds, token counts, sha256 of the prompt\nA batch that already has an answer is skipped. One batch at a time: a local model does not\nget faster by running several at once.\n&quot;&quot;&quot;\nimport argparse, hashlib, json, pathlib, time, urllib.request\n\nHERE = pathlib.Path(__file__).parent\nURL = &quot;http://localhost:11434/api/chat&quot;\n\n\ndef run_batch(path, raw, a):\n    name = path.stem; out = raw / f&quot;{name}.json&quot;\n    if out.exists() and out.stat().st_size &gt; 2:\n        return name, &quot;skipped&quot;, 0\n    batch = json.loads(path.read_text(encoding=&quot;utf-8&quot;))\n    prompt = (HERE / &quot;prompt.md&quot;).read_text(encoding=&quot;utf-8&quot;)\n    for r in batch[&quot;records&quot;]:\n        prompt += f&quot;\\n[{r[&#x27;id&#x27;]}]\\n{r[&#x27;text&#x27;]}\\n&quot;\n    body = {&quot;model&quot;: a.model, &quot;messages&quot;: [{&quot;role&quot;: &quot;user&quot;, &quot;content&quot;: prompt}], &quot;stream&quot;: False, &quot;think&quot;: a.think,\n            &quot;format&quot;: json.loads((HERE / &quot;schema.json&quot;).read_text(encoding=&quot;utf-8&quot;)),\n            &quot;options&quot;: {&quot;temperature&quot;: 0, &quot;num_ctx&quot;: a.ctx, &quot;num_predict&quot;: a.max_out}}\n    t = time.time(); err = &quot;&quot;; res = {}\n    try:\n        req = urllib.request.Request(URL, json.dumps(body).encode(), {&quot;Content-Type&quot;: &quot;application/json&quot;})\n        res = json.loads(urllib.request.urlopen(req, timeout=3600).read())\n        text = res.get(&quot;message&quot;, {}).get(&quot;content&quot;, &quot;&quot;)\n        json.loads(text)                       # must be valid JSON, or the batch counts as failed\n        out.write_text(text, encoding=&quot;utf-8&quot;)\n    except Exception as e:\n        err = repr(e)[:500]\n        if res.get(&quot;message&quot;, {}).get(&quot;content&quot;):\n            (raw / f&quot;{name}.bad.txt&quot;).write_text(res[&quot;message&quot;][&quot;content&quot;], encoding=&quot;utf-8&quot;)\n    secs = round(time.time() - t, 1)\n    (raw / f&quot;{name}.meta.json&quot;).write_text(json.dumps({\n        &quot;batch&quot;: name, &quot;reader&quot;: &quot;ollama&quot;, &quot;model&quot;: a.model, &quot;think&quot;: a.think, &quot;options&quot;: body[&quot;options&quot;], &quot;seconds&quot;: secs,\n        &quot;records&quot;: len(batch[&quot;records&quot;]), &quot;prompt_chars&quot;: len(prompt), &quot;prompt_sha256&quot;: hashlib.sha256(prompt.encode()).hexdigest(),\n        &quot;input_tokens&quot;: res.get(&quot;prompt_eval_count&quot;), &quot;output_tokens&quot;: res.get(&quot;eval_count&quot;), &quot;done_reason&quot;: res.get(&quot;done_reason&quot;),\n        &quot;thinking_chars&quot;: len(res.get(&quot;message&quot;, {}).get(&quot;thinking&quot;) or &quot;&quot;), &quot;error&quot;: err}, ensure_ascii=False, indent=1), encoding=&quot;utf-8&quot;)\n    return name, &quot;ok&quot; if not err else f&quot;FAILED {err}&quot;, secs\n\n\nif __name__ == &quot;__main__&quot;:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(&quot;run&quot;); ap.add_argument(&quot;--model&quot;, required=True); ap.add_argument(&quot;--think&quot;, action=&quot;store_true&quot;)\n    ap.add_argument(&quot;--ctx&quot;, type=int, default=16384); ap.add_argument(&quot;--max-out&quot;, type=int, default=8192); ap.add_argument(&quot;--only&quot;, default=&quot;&quot;)\n    a = ap.parse_args()\n    raw = HERE / a.run / &quot;raw&quot;; raw.mkdir(parents=True, exist_ok=True)\n    paths = sorted((HERE / a.run / &quot;batches&quot;).glob(&quot;b*.json&quot;))\n    if a.only: paths = [p for p in paths if p.stem in a.only.split(&quot;,&quot;)]\n    for p in paths: print(*run_batch(p, raw, a), flush=True)\n</pre></details><details><summary><code>compare.py</code> <span class='mute'>38 lines</span></summary><pre class='code'># /// script\n# requires-python = &quot;&gt;=3.11&quot;\n# ///\n&quot;&quot;&quot;Compare two readers on the same records.   uv run compare.py pilot pilot_qwen\nReads &lt;run&gt;/out/mentions.csv and dropped.csv of both runs (made by link.py). Writes\n&lt;second run&gt;/out/compare.json and compare.csv (every string found by only one reader).&quot;&quot;&quot;\nimport csv, json, pathlib, sys, collections\nHERE = pathlib.Path(__file__).parent\nA, B = sys.argv[1], sys.argv[2]\n\n\ndef load(run):\n    rows = list(csv.DictReader((HERE / run / &quot;out/mentions.csv&quot;).open(encoding=&quot;utf-8-sig&quot;)))\n    drop = list(csv.DictReader((HERE / run / &quot;out/dropped.csv&quot;).open(encoding=&quot;utf-8-sig&quot;)))\n    return rows, drop\n\n\nra, da = load(A); rb, db = load(B)\nrep = {&quot;runs&quot;: [A, B]}; only = []\nfor typ in (&quot;person&quot;, &quot;place&quot;):\n    sa = {(r[&quot;record_id&quot;], r[&quot;text&quot;]): r for r in ra if r[&quot;type&quot;] == typ}\n    sb = {(r[&quot;record_id&quot;], r[&quot;text&quot;]): r for r in rb if r[&quot;type&quot;] == typ}\n    both = sa.keys() &amp; sb.keys()\n    la = {(k[0], v[&quot;linked_id&quot;]) for k, v in sa.items() if v[&quot;linked_id&quot;]}; lb = {(k[0], v[&quot;linked_id&quot;]) for k, v in sb.items() if v[&quot;linked_id&quot;]}\n    rep[typ] = {f&quot;strings_{A}&quot;: len(sa), f&quot;strings_{B}&quot;: len(sb), &quot;in_both&quot;: len(both), f&quot;only_{A}&quot;: len(sa) - len(both), f&quot;only_{B}&quot;: len(sb) - len(both),\n                f&quot;invented_{A}&quot;: sum(1 for d in da if d[&quot;type&quot;] == typ), f&quot;invented_{B}&quot;: sum(1 for d in db if d[&quot;type&quot;] == typ),\n                f&quot;linked_{A}&quot;: len(la), f&quot;linked_{B}&quot;: len(lb), &quot;linked_in_both&quot;: len(la &amp; lb),\n                &quot;kind_differs&quot;: sum(1 for k in both if sa[k][&quot;kind&quot;] != sb[k][&quot;kind&quot;]),\n                &quot;full_name_differs&quot;: sum(1 for k in both if sa[k][&quot;full_name&quot;] != sb[k][&quot;full_name&quot;])}\n    for run, s, o in ((A, sa, sb), (B, sb, sa)):\n        for k in sorted(s.keys() - o.keys()):\n            only.append({&quot;only_in&quot;: run, &quot;type&quot;: typ, &quot;record_id&quot;: k[0], &quot;text&quot;: k[1], &quot;kind&quot;: s[k][&quot;kind&quot;], &quot;method&quot;: s[k][&quot;method&quot;], &quot;linked_name&quot;: s[k][&quot;linked_name&quot;]})\nout = HERE / B / &quot;out&quot;\n(out / &quot;compare.json&quot;).write_text(json.dumps(rep, ensure_ascii=False, indent=1), encoding=&quot;utf-8&quot;)\nwith (out / &quot;compare.csv&quot;).open(&quot;w&quot;, newline=&quot;&quot;, encoding=&quot;utf-8-sig&quot;) as f:\n    w = csv.DictWriter(f, fieldnames=list(only[0].keys()) if only else [&quot;only_in&quot;]); w.writeheader(); w.writerows(only)\nprint(json.dumps(rep, ensure_ascii=False, indent=1))\n</pre></details>"}